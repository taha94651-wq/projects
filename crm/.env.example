# Supabase (optional). When BOTH are set the app uses Supabase (Postgres + Auth).
# When they are missing the app runs in "Local browser storage" mode (IndexedDB in this browser only).
# Use the *anon / publishable* key only. NEVER put the service_role key in this project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
